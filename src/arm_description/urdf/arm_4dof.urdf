<?xml version="1.0" encoding="utf-8"?>
<!--
  小机械臂 V2 (Mini 系列) — 4-DOF 机械臂 URDF
  由 firmware/inv_geo.py 的运动学参数等价转换而来

  构型：底座旋转(J0) + 平面 3R 俯仰臂(J1/J2/J3)，共 4 个运动学关节
  夹爪(J4) 为末端执行器，非运动学关节，此处作为固定 tool 连杆建模

  坐标系约定（与代码 forward_4dof 几何法对齐）：
    X 朝前（水平伸出方向）
    Y 水平、垂直 X（由底座 J0 旋转决定）
    Z 竖直向上

  零位约定：本 URDF 取"连杆水平向前"为标准零位（joint2 原点 rpy=0）。
  固件代码零位 = 竖直向上；两者相差 90°，在驱动层做集中换算。

  关键参数：
    L1 = 0.06 m   (肩→肘)
    L2 = 0.06 m   (肘→腕)
    L3 = 0.06 m   (腕→末端)
    base_height = 0.025 m

  注意：本文件是 ROS 用副本，与仓库根目录 arm_4dof.urdf 保持一致。
-->
<robot name="arm_4dof_mini">

  <material name="base_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="link_blue">
    <color rgba="0.2 0.5 0.9 1.0"/>
  </material>
  <material name="link_orange">
    <color rgba="0.95 0.55 0.1 1.0"/>
  </material>
  <material name="link_green">
    <color rgba="0.2 0.8 0.3 1.0"/>
  </material>

  <!-- ============ 底座（固定于世界） ============ -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <material name="base_grey"/>
    </visual>
  </link>

  <!-- 关节1：底座旋转 (J0)，绕 Z 轴 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="3.0"/>
    <!-- J0 范围 [-90°, 90°] -->
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.04"/>
      </geometry>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <material name="link_blue"/>
    </visual>
  </link>

  <!-- 关节2：肩关节 (J1)，转轴由竖直转水平，零位水平向前 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <!--
      rpy 修正为 0 0 0：URDF 零位 = 连杆水平向前（与注释一致）。
      固件零位 = 竖直向上，二者相差 90°，该换算在驱动层
      servo_protocol.h 的 code<->urdf 转换中集中处理（joint2 偏移 -90°）。
    -->
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.65806" upper="0.78540" effort="5.0" velocity="3.0"/>
    <!-- 注：该限位值按原始文件保留（用户确认为 MPC 硬约束，URDF 空间） -->
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.06 0.02 0.02"/>
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <material name="link_orange"/>
    </visual>
  </link>

  <!-- 关节3：肘关节 (J2)，沿连杆1 (L1) -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="0.78540" effort="5.0" velocity="3.0"/>
    <!-- J2 范围 [-120°, 45°] -->
  </joint>

  <link name="link3">
    <visual>
      <geometry>
        <box size="0.06 0.02 0.02"/>
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <material name="link_orange"/>
    </visual>
  </link>

  <!-- 关节4：腕关节 (J3)，沿连杆2 (L2) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.55334" upper="1.55334" effort="5.0" velocity="3.0"/>
    <!-- J3 范围 [-89°, 89°] -->
  </joint>

  <link name="link4">
    <visual>
      <geometry>
        <box size="0.06 0.015 0.015"/>
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <material name="link_green"/>
    </visual>
  </link>

  <!-- 末端执行器（夹爪），固定 tool，非运动学关节 -->
  <joint name="tool_fixed" type="fixed">
    <parent link="link4"/>
    <child link="tool"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="link_green"/>
    </visual>
  </link>

</robot>
